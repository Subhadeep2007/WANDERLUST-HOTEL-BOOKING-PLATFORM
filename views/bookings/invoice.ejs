<% layout("/layouts/boilerplate") %>

    <div class="container mt-5 mb-5">

        <div class="row justify-content-center">

            <div class="col-lg-8">

                <div class="card shadow-lg border-0">

                    <!-- ================= HEADER ================= -->

                    <div class="card-body p-4">

                        <div class="d-flex justify-content-between align-items-center">

                            <div>

                                <h2 class="fw-bold mb-1">
                                    WanderLust
                                </h2>

                                <p class="text-muted mb-0">
                                    Booking Receipt
                                </p>

                            </div>


                            <div class="text-end">

                                <span class="badge bg-success fs-6">
                                <%= booking.paymentStatus || "Paid" %>
                            </span>

                                <p class="small text-muted mt-2 mb-0">
                                    Booking ID:
                                    <%= booking._id %>
                                </p>

                            </div>

                        </div>


                        <hr class="my-4">


                        <!-- ================= PROPERTY ================= -->

                        <h5 class="fw-bold mb-3">

                            <i class="fa-solid fa-house text-primary"></i> Property Details

                        </h5>


                        <div class="row">

                            <div class="col-md-4">

                                <%
                            let imageUrl =
                                "https://images.unsplash.com/photo-1566073771259-6a8506099945";

                            if (
                                booking.listing &&
                                booking.listing.image
                            ) {

                                if (
                                    typeof booking.listing.image === "string"
                                ) {

                                    imageUrl =
                                        booking.listing.image;

                                } else if (
                                    booking.listing.image.url
                                ) {

                                    imageUrl =
                                        booking.listing.image.url;

                                }
                            }
                            %>


                                    <img src="<%= imageUrl %>" class="img-fluid rounded" style="
                                    width:100%;
                                    height:180px;
                                    object-fit:cover;
                                ">

                            </div>


                            <div class="col-md-8">

                                <h4 class="fw-bold">

                                    <%= booking.listing
                                    ? booking.listing.title
                                    : "Listing Removed" %>

                                </h4>


                                <p class="text-muted">

                                    <i class="fa-solid fa-location-dot text-danger"></i>

                                    <%= booking.listing
                                    ? booking.listing.location
                                    : "N/A" %>

                                        <% if(
                                    booking.listing &&
                                    booking.listing.country
                                ){ %>

                                            ,
                                            <%= booking.listing.country %>

                                                <% } %>

                                </p>


                                <p>

                                    <b>Room Type:</b>

                                    <span class="badge bg-primary">

                                    <%= booking.roomPlan || "N/A" %>

                                </span>

                                </p>

                            </div>

                        </div>


                        <hr class="my-4">


                        <!-- ================= SELLER ================= -->

                        <h5 class="fw-bold mb-3">

                            <i class="fa-solid fa-store"></i> Seller Details

                        </h5>


                        <% if(
                        booking.listing &&
                        booking.listing.owner
                    ){ %>

                            <div class="d-flex align-items-center gap-3 mb-3">

                                <% if(
                                booking.listing.owner.profilePicture &&
                                booking.listing.owner.profilePicture.url
                            ){ %>

                                    <img src="<%= booking.listing.owner.profilePicture.url %>" class="rounded-circle" style="
                                        width:60px;
                                        height:60px;
                                        object-fit:cover;
                                    ">

                                    <% } else { %>

                                        <div class="rounded-circle bg-secondary text-white
                                    d-flex align-items-center justify-content-center" style="
                                        width:60px;
                                        height:60px;
                                        font-size:24px;
                                    ">

                                            <i class="fa-solid fa-user"></i>

                                        </div>

                                        <% } %>


                                            <div>

                                                <p class="mb-1 fw-bold">

                                                    <%= booking.listing.owner.username ||
                                        "Username unavailable" %>

                                                </p>


                                                <p class="mb-0 text-muted">

                                                    <i class="fa-solid fa-envelope"></i>

                                                    <%= booking.listing.owner.email ||
                                        "Email unavailable" %>

                                                </p>

                                            </div>

                            </div>

                            <% } else { %>

                                <p class="text-danger">

                                    Seller account unavailable

                                </p>

                                <% } %>


                                    <hr class="my-4">


                                    <!-- ================= CUSTOMER ================= -->

                                    <h5 class="fw-bold mb-3">

                                        <i class="fa-solid fa-user-check"></i> Booking By

                                    </h5>


                                    <% if(booking.user){ %>

                                        <div class="d-flex align-items-center gap-3 mb-3">

                                            <% if(
                                booking.user.profilePicture &&
                                booking.user.profilePicture.url
                            ){ %>

                                                <img src="<%= booking.user.profilePicture.url %>" class="rounded-circle" style="
                                        width:60px;
                                        height:60px;
                                        object-fit:cover;
                                    ">

                                                <% } else { %>

                                                    <div class="rounded-circle bg-secondary text-white
                                    d-flex align-items-center justify-content-center" style="
                                        width:60px;
                                        height:60px;
                                        font-size:24px;
                                    ">

                                                        <i class="fa-solid fa-user"></i>

                                                    </div>

                                                    <% } %>


                                                        <div>

                                                            <p class="mb-1 fw-bold">

                                                                <%= booking.user.username ||
                                        "Username unavailable" %>

                                                            </p>


                                                            <p class="mb-0 text-muted">

                                                                <i class="fa-solid fa-envelope"></i>

                                                                <%= booking.user.email ||
                                        "Email unavailable" %>

                                                            </p>

                                                        </div>

                                        </div>

                                        <% } %>


                                            <hr class="my-4">


                                            <!-- ================= BOOKING DETAILS ================= -->

                                            <h5 class="fw-bold mb-3">

                                                <i class="fa-solid fa-calendar-check"></i> Booking Details

                                            </h5>


                                            <div class="row">

                                                <div class="col-md-6">

                                                    <p>

                                                        <b>Check-in:</b>

                                                        <%= new Date(
                                    booking.fromDate
                                ).toDateString() %>

                                                    </p>

                                                </div>


                                                <div class="col-md-6">

                                                    <p>

                                                        <b>Check-out:</b>

                                                        <%= new Date(
                                    booking.toDate
                                ).toDateString() %>

                                                    </p>

                                                </div>


                                                <div class="col-md-6">

                                                    <p>

                                                        <b>Guests:</b>

                                                        <%= booking.guests %>

                                                    </p>

                                                </div>


                                                <div class="col-md-6">

                                                    <p>

                                                        <b>Room Type:</b>

                                                        <%= booking.roomPlan %>

                                                    </p>

                                                </div>

                                            </div>


                                            <hr class="my-4">


                                            <!-- ================= PAYMENT ================= -->

                                            <h5 class="fw-bold mb-3">

                                                <i class="fa-solid fa-credit-card"></i> Payment Details

                                            </h5>


                                            <div class="d-flex justify-content-between">

                                                <span>
                            Room Price
                        </span>

                                                <span>
                            ₹<%= booking.basePrice %>
                        </span>

                                            </div>


                                            <div class="d-flex justify-content-between mt-2">

                                                <span>
                            Platform Fee
                        </span>

                                                <span>
                            ₹<%= booking.platformFee %>
                        </span>

                                            </div>


                                            <div class="d-flex justify-content-between mt-2">

                                                <span>
                            GST
                        </span>

                                                <span>
                            ₹<%= booking.gst %>
                        </span>

                                            </div>


                                            <hr>


                                            <div class="d-flex justify-content-between">

                                                <h4 class="fw-bold">
                                                    Total Paid
                                                </h4>

                                                <h4 class="fw-bold text-success">

                                                    ₹
                                                    <%= booking.totalPrice %>

                                                </h4>

                                            </div>


                                            <hr class="my-4">


                                            <!-- ================= TRANSACTION ================= -->

                                            <h5 class="fw-bold mb-3">

                                                <i class="fa-solid fa-receipt"></i> Transaction Details

                                            </h5>


                                            <div class="bg-light rounded p-3">

                                                <p class="mb-2">

                                                    <b>Payment ID:</b>

                                                    <span class="text-break">

                                <%= booking.paymentId || "N/A" %>

                            </span>

                                                </p>


                                                <p class="mb-0">

                                                    <b>Order ID:</b>

                                                    <span class="text-break">

                                <%= booking.orderId || "N/A" %>

                            </span>

                                                </p>

                                            </div>


                                            <!-- ================= ACTIONS ================= -->

                                            <div class="d-flex gap-2 mt-4">

                                                <button onclick="window.print()" class="btn btn-primary">

                            <i class="fa-solid fa-print"></i>

                            Print / Save PDF

                        </button>


                                                <a href="/bookings/my-bookings" class="btn btn-outline-secondary">

                            Back to My Bookings

                        </a>

                                            </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <style>
        @media print {
            .navbar,
            footer,
            .btn,
            .alert {
                display: none !important;
            }
            body {
                background: white !important;
            }
            .card {
                box-shadow: none !important;
                border: none !important;
            }
        }
    </style>